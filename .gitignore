# ============================================
# .gitignore - Archivos a ignorar en Git
# ============================================

# Variables de Entorno
.env
.env.local
.env.*.local
.env*.example

# Logs
logs/
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node (si se usa)
node_modules/
package-lock.json
yarn.lock

# Caché
__pycache__/
*.pyc
.cache/

# Archivos temporales
tmp/
temp/
*.tmp

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos compilados
*.o
*.so
*.out

# Backups
*.bak
*.backup
*~

# IDE específicos
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS específicos
.env.local
.env.*.local
